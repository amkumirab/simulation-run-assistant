# Optional Telegram notifications and command bot. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional runtime paths.
SIM_ASSISTANT_DB=.sim-assistant/jobs.db
SIM_ASSISTANT_ARTIFACTS=artifacts

# Optional COMSOL batch integration.
COMSOL_EXECUTABLE=C:\Program Files\COMSOL\COMSOL63\Multiphysics\bin\win64\comsolbatch.exe
COMSOL_MODEL_PATH=C:\path\to\your-model.mph
COMSOL_STUDY_TAG=std1
COMSOL_TIMEOUT_SECONDS=3600
COMSOL_CORES=4
